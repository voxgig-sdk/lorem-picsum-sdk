            }
          },
          {
            "description": "Height of the image in pixels",
            "in": "path",
            "name": "height",
            "required": true,
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Convert image to grayscale",
            "in": "query",
            "name": "grayscale",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Apply blur effect (1-10)",
            "in": "query",
            "name": "blur",
            "required": false,
