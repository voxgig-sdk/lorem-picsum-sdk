                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/seed/{seed}/info"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              seed: "id"
            }
          }
          s: [
            {
              lit: "seed"
            }
            {
              var: "id"
            }
            {
              lit: "info"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



