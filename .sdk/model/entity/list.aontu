# Entity: list

main: kit: entity: list: {

  alias: field: {}

  fields: {
    author: {
      h: "Author"
      n: "author"
      r: true
      sh: "Name of the image author"
      t: "`$STRING`"
    }
    download_url: {
      fo: "uri"
      h: "Download Url"
      n: "download_url"
      r: true
      sh: "URL to download the image from Picsum"
      t: "`$STRING`"
    }
    height: {
      h: "Height"
      n: "height"
      r: true
      sh: "Original height of the image in pixels"
      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier for the image"
      t: "`$STRING`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: true
      sh: "URL to the original image on Unsplash"
      t: "`$STRING`"
    }
    width: {
      h: "Width"
      n: "width"
      r: true
      sh: "Original width of the image in pixels"
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "list"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v2/list"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 30
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/v2/list"
          q: {
            exist: [
              "limit"
              "page"
            ]
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "list"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
